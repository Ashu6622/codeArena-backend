{
  "name": "codearena-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "tsx watch apps/api/src/main.ts",
    "build": "tsc",
    "test": "npm run build && jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run db:validate && npm test"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
